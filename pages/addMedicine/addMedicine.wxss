/* pages/addMedicine/addMedicine.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: linear-gradient(180deg, #fff6f0 0%, #ffe3d3 100%);
  box-sizing: border-box;
}

.card {
  width: 92vw;
  max-width: 600rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(217, 79, 48, 0.10);
  padding: 36rpx 32rpx 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 8rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #d94f30;
  margin-bottom: 8rpx;
  text-align: center;
}

.top-icon {
  width: 70rpx;
  height: 70rpx;
  display: block;
}

.divider {
  width: 100%;
  height: 0;
  border-bottom: 2rpx dashed #ffe3d3;
  margin: 24rpx 0 24rpx 0;
  border-radius: 2rpx;
}

.elder-select-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 0;
}
.elder-select-label {
  font-size: 32rpx;
  color: #d94f30;
  font-weight: 600;
  min-width: 120rpx;
  line-height: 64rpx;
  text-align: center;
}
.elder-select-value {
  font-size: 36rpx;
  color: #666;
  padding: 0 28rpx;
  background: #fff6f0;
  border-radius: 18rpx;
  border: 2rpx solid #eee;
  min-width: 160rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  justify-content: center;
}

form {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.form-group {
  width: 100%;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  font-size: 32rpx;
  color: #d94f30;
  margin-bottom: 10rpx;
}

.form-input {
  width: 98%;
  height: 64rpx;
  font-size: 36rpx;
  border: 2rpx solid #d94f30;
  border-radius: 18rpx;
  padding: 0 28rpx;
  margin-bottom: 0;
  background: #fff;
  box-sizing: border-box;
  outline: none;
  color: #333;
  font-family: inherit;
  transition: border 0.2s;
}
.form-input:focus, .textarea:focus {
  border: 2rpx solid #ff7a59;
}
.textarea {
  min-height: 120rpx;
  resize: none;
  padding: 18rpx 28rpx;
  font-size: 36rpx;
  width: 98%;
  border: 2rpx solid #d94f30;
  border-radius: 18rpx;
  background: #fff;
  box-sizing: border-box;
  color: #333;
  font-family: inherit;
  margin-bottom: 0;
  transition: border 0.2s;
}

.medicine-img-wrap {
  position: relative;
  width: 90%;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.medicine-img {
  width: 100%;
  height: 180rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #d94f30;
  background: #fff6f0;
  object-fit: cover;
}
.add-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 60rpx;
  height: 60rpx;
  transform: translate(-50%, -50%);
  opacity: 0.6;
}

.submit-btn {
  width: 98%;
  background: linear-gradient(90deg, #ffb199 0%, #ff7a59 100%);
  color: #fff;
  border-radius: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 16rpx 0;
  margin-top: 40rpx;
  margin-bottom: 12rpx;
  border: none;
  box-shadow: 0 6rpx 18rpx #ffd6c2;
  transition: background 0.2s, box-shadow 0.2s;
  letter-spacing: 2rpx;
}
.submit-btn:active {
  background: linear-gradient(90deg, #ff7a59 0%, #ffb199 100%);
  box-shadow: 0 2rpx 8rpx #ffd6c2;
}

.tips {
  width: 100%;
  text-align: center;
  color: #d94f30;
  font-size: 28rpx;
  margin-top: 32rpx;
  opacity: 0.85;
}

.icon-bg {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffe3d3 0%, #ffb199 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 0 auto;
  box-shadow: 0 2rpx 8rpx #ffd6c2;
}