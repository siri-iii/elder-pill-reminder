<view class="chat-container">
  <view class="header">
    <view class="title-section">
      <view class="title">智能健康助手</view>
      <view class="subtitle">您的贴心健康顾问</view>
    </view>
  </view>

  <scroll-view scroll-y="true" class="chat-messages" scroll-into-view="{{scrollToMessage}}">
    <block wx:for="{{messages}}" wx:key="index">
      <view class="message {{item.type === 'user' ? 'user-message' : 'ai-message'}}" id="msg-{{index}}">
        <image class="avatar" src="{{item.type === 'user' ? '/images/user-avatar.png' : '/images/ai-avatar.png'}}" mode="aspectFit"></image>
        <view class="message-content">{{item.content}}</view>
      </view>
    </block>
  </scroll-view>

  <view class="suggested-questions">
    <view class="suggested-title">您可能想问：</view>
    <view class="question-grid">
      <view class="question-item" 
            wx:for="{{suggestedQuestions}}" 
            wx:key="index"
            bindtap="onQuestionTap"
            data-question="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <view class="input-area">
    <view class="input-wrapper">
      <input class="message-input" 
             value="{{inputMessage}}"
             bindinput="onInputChange"
             placeholder="请输入您的问题"
             placeholder-class="input-placeholder"/>
      <view class="voice-input-btn">
        <image class="voice-icon" src="/images/voice-icon.png" mode="aspectFit"></image>
      </view>
    </view>
    <view class="send-btn {{inputMessage ? 'active' : ''}}" bindtap="sendMessage">发送</view>
  </view>
</view> 