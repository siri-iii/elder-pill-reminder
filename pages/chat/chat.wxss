.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(90deg, #ffb199 0%, #ff7a59 100%);
  padding: 20rpx 30rpx;
  color: white;
  text-align: center;
}

.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 32rpx;
  opacity: 0.8;
}

.chat-messages {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.user-message {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin: 0 20rpx;
}

.message-content {
  max-width: 70%;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
  line-height: 1.5;
}

.user-message .message-content {
  background-color: #ff7a59;
  color: white;
}

.ai-message .message-content {
  background-color: white;
  color: #333;
}

.suggested-questions {
  padding: 20rpx;
  background-color: white;
  border-top: 1rpx solid #eee;
}

.suggested-title {
  font-size: 36rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.question-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.question-item {
  background-color: #f8f8f8;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  color: #666;
  text-align: center;
}

.input-area {
  padding: 20rpx;
  background-color: white;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
}

.input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 20rpx;
  margin-right: 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  font-size: 36rpx;
  padding: 0 20rpx;
}

.voice-input-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
}

.voice-icon {
  width: 40rpx;
  height: 40rpx;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  background-color: #ccc;
  color: white;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.send-btn.active {
  background: linear-gradient(90deg, #ffb199 0%, #ff7a59 100%);
}

.input-placeholder {
  color: #999;
  font-size: 36rpx;
} 