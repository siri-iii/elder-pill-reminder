/* pages/quickCheckin/quickCheckin.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: linear-gradient(180deg, #fff6f0 0%, #ffe3d3 100%);
  box-sizing: border-box;
}

.card {
  width: 92vw;
  max-width: 600rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(217, 79, 48, 0.10);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.checkin-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 60rpx;
}

.checkin-text {
  font-size: 48rpx;
  color: #d94f30;
  font-weight: bold;
  margin-bottom: 80rpx;
  text-align: center;
}

.confirm-button {
  width: 90%;
  height: 120rpx;
  background: linear-gradient(90deg, #ffb199 0%, #ff7a59 100%);
  color: white;
  border-radius: 60rpx;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(217, 79, 48, 0.2);
  transition: all 0.3s ease;
}

.confirm-button:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(217, 79, 48, 0.2);
}
