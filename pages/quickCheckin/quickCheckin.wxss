.container {
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff6f0 0%, #ffe3d3 100%);
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #d65c41;
}

.date {
  font-size: 28rpx;
  color: #b85c4a; 
  margin-top: 10rpx;
}

.medication-list {
  position: absolute;
  top: 150rpx;
  margin-bottom: 60rpx;
  width: 80%;
}

.medication-card {
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(214, 92, 65, 0.1);
  border: 1rpx solid #ffe3d3;
}

.medication-card.taken {
  background-color: rgba(240, 249, 235, 0.9);
  border: 1rpx solid #d4edc9;
}

.medication-info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #d65c41;
  margin-bottom: 8rpx;
}

.dosage {
  font-size: 26rpx;
  color: #b85c4a; 
  margin-bottom: 5rpx;
}

.method {
  font-size: 26rpx;
  color: #b85c4a; 
  margin-bottom: 5rpx;
}

.time-container {
  position: absolute;
  right: 200rpx;
  width: 100rpx;
}

.time {
  font-size: 40rpx;
  color: #d65c41;
  font-weight: bold;
}

.check-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #d65c41;
  color: #fff6f0;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.check-btn.checked {
  background-color: #ffe3d3; 
  color: #d65c41; 
  border: 1rpx solid #d65c41;
}

.check-btn:active {
  background-color: #b85c4a;
  transform: scale(0.98);
}
