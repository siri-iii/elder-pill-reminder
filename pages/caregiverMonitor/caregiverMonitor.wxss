/* pages/caregiverMonitor/caregiverMonitor.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(180deg, #fff6f0 0%, #ffe3d3 100%);
  box-sizing: border-box;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #d94f30;
  margin-top: 60rpx;
  text-align: center;
}

.subtitle {
  font-size: 30rpx;
  color: #666;
  margin-top: 20rpx;
  margin-bottom: 60rpx;
  text-align: center;
}

.card-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 100rpx;
}

.card {
  width: 90%;
  background: #fff;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 36rpx rgba(217, 79, 48, 0.12);
  border: 4rpx solid transparent;
  padding: 40rpx 0 32rpx 0;
  transition: box-shadow 0.2s, border 0.2s, transform 0.1s;
}

.card:active {
  border: 4rpx solid #d94f30;
  box-shadow: 0 16rpx 48rpx rgba(217, 79, 48, 0.18);
  transform: scale(0.97);
}

.card-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 36rpx;
  color: #d94f30;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-top: 10rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
  text-align: center;
}

.medicine-list {
  margin-bottom: 20px;
}
.list-title {
  font-size: 18px;
  margin-bottom: 10px;
}
.medicine-item {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #eeeeee;
}
.settings-button {
  width: 100%;
}
