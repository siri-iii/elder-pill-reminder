<!-- pages/caregiverMonitor/caregiverMonitor.wxml -->
<view class="container">
  <view class="title">家属监管中心</view>
  <view class="subtitle">请选择您要进行的操作</view>
  <view class="card-container">
    <view class="card" bindtap="goToElderlyManage">
      <image class="card-icon" src="/images/elderly-icon.png" mode="aspectFit" />
      <text class="card-title">老人信息管理</text>
      <text class="card-desc">绑定/解绑老人，管理老人账号</text>
    </view>
    <view class="card" bindtap="goToAddMedicine">
      <image class="card-icon" src="/images/medicine-icon.png" mode="aspectFit" />
      <text class="card-title">为老人添加药品信息</text>
      <text class="card-desc">录入药品名称、图片、功能、服用频次</text>
    </view>
    <view class="card" bindtap="goToCheckinStatus">
      <image class="card-icon" src="/images/checkin-icon.png" mode="aspectFit" />
      <text class="card-title">查询老人服药打卡情况</text>
      <text class="card-desc">按日期查看打卡记录与状态</text>
    </view>
  </view>
</view>
