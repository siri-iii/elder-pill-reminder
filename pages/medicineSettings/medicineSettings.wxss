/* pages/medicineSettings/medicineSettings.wxss */
.container {
  padding: 20px;
}
.medicine-list {
  margin-bottom: 20px;
}
.list-title {
  font-size: 18px;
  margin-bottom: 10px;
}
.medicine-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #eeeeee;
}
.item-actions {
  display: flex;
}
.item-actions button {
  margin-left: 10px;
}
.add-button {
  width: 100%;
}
