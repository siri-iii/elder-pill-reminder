<view class="container">
  <view class="title">信息管理</view>

  <view class="elder-list">
    <block wx:for="{{elders}}" wx:key="index">
      <view class="elder-card" style="width: 90%;" data-index="{{index}}" bindtap="showElderDetail">
        <image class="elder-avatar-large" src="/images/elderly-{{item.gender === '女' ? 'female' : 'male'}}.png" mode="aspectFit"/>
        <view class="elder-info-centered">
          <view class="elder-name-large">{{item.name}}</view>
          <view class="elder-detail-small">性别：{{item.gender}} ｜ 年龄：{{item.age}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="elder-card add-card" bindtap="showAddForm">
    <image class="add-icon" src="/images/add-icon.png" mode="aspectFit" />
    <text class="add-text">添加信息</text>
  </view>

  <view wx:if="{{showForm}}" class="form-mask">
    <view class="form-dialog">
      <view class="form-title">添加老人信息</view>
      <input class="form-input" placeholder="姓名" value="{{form.name}}" bindinput="onNameInput" />
      <picker class="form-input" mode="selector" range="{{genderOptions}}" value="{{form.genderIndex}}" bindchange="onGenderChange">
        <view>性别：{{genderOptions[form.genderIndex]}}</view>
      </picker>
      <input class="form-input" type="number" placeholder="年龄" value="{{form.age}}" bindinput="onAgeInput" />
      <input class="form-input" placeholder="病情信息（可选）" value="{{form.condition}}" bindinput="onConditionInput" />
      <view class="form-btns">
        <button class="form-btn" bindtap="addElder">添加</button>
        <button class="form-btn cancel" bindtap="hideAddForm">取消</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showDetail}}" class="form-mask">
    <view class="form-dialog detail-dialog">
      <button class="close-btn" bindtap="hideElderDetail">
        <view class="close-icon">×</view>
      </button>
      <view class="form-title">详细信息</view>
      <image class="elder-avatar" src="/images/elderly-{{elders[detailIndex].gender === '女' ? 'female' : 'male'}}.png" mode="aspectFit" style="margin: 0 auto 24rpx auto;box-shadow:0 4rpx 16rpx #ffd6c2;" />
      <view class="elder-name" style="text-align:center;font-size:36rpx;margin-bottom:8rpx;">{{elders[detailIndex].name}}</view>
      <view class="elder-detail" style="text-align:center;">性别：{{elders[detailIndex].gender}} ｜ 年龄：{{elders[detailIndex].age}}</view>
      <view class="elder-condition" style="text-align:center;margin:16rpx 0 0 0;color:#d94f30;font-size:28rpx;">
        {{elders[detailIndex].condition ? ('病情信息：' + elders[detailIndex].condition) : '暂无病情信息'}}
      </view>

      <view class="detail-btns">
        <button class="detail-btn edit-btn" bindtap="editElder" data-index="{{detailIndex}}">修改信息</button>
        <button class="detail-btn delete-btn" bindtap="deleteElder" data-index="{{detailIndex}}">删除老人</button>
      </view>
    </view>
  </view>
</view> 
