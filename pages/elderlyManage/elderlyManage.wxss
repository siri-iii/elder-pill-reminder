.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(180deg, #fff6f0 0%, #ffe3d3 100%);
  box-sizing: border-box;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #d94f30;
  margin-top: 60rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

.elder-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.elder-card {
  width: 90%;
  background: #fff;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 36rpx rgba(217, 79, 48, 0.12);
  border: 4rpx solid transparent;
  padding: 32rpx 0 24rpx 0;
  margin-bottom: 32rpx;
  transition: box-shadow 0.2s, border 0.2s, transform 0.1s;
}

.elder-card:active {
  border: 4rpx solid #d94f30;
  box-shadow: 0 16rpx 48rpx rgba(217, 79, 48, 0.18);
  transform: scale(0.97);
}

.elder-avatar-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin: 0 auto 12rpx auto;
  box-shadow: 0 4rpx 16rpx #ffd6c2;
  background: #fff;
  display: block;
}

.elder-info-centered {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 0;
}

.elder-name-large {
  font-size: 36rpx;
  color: #d94f30;
  font-weight: 700;
  margin-bottom: 4rpx;
  text-align: center;
}

.elder-detail-small {
  font-size: 26rpx;
  color: #888;
  text-align: center;
}

.delete-btn {
  background: #fff0f0;
  color: #d94f30;
  border: 2rpx solid #d94f30;
  border-radius: 24rpx;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  margin-top: 16rpx;
}

.add-card {
  justify-content: center;
  flex-direction: column;
  align-items: center;
  min-height: 180rpx;
}

.add-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
}

.add-text {
  font-size: 28rpx;
  color: #d94f30;
}

/* 弹窗表单样式 */
.form-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.form-dialog {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  width: 80vw;
  box-shadow: 0 8rpx 32rpx rgba(217, 79, 48, 0.18);
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.form-title {
  font-size: 32rpx;
  color: #d94f30;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}
.form-input {
  font-size: 28rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.form-btns {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}
.form-btn {
  flex: 1;
  margin: 0 8rpx;
  background: #d94f30;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
}
.form-btn.cancel {
  background: #eee;
  color: #888;
} 