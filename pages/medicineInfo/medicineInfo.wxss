.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff6f0 0%, #ffe3d3 100%);
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  color: #d94f30;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 36rpx;
  color: #ff7a59;
}

.search-box {
  position: relative;
  margin-bottom: 40rpx;
}

.search-input {
  background-color: white;
  height: 100rpx;
  border-radius: 50rpx;
  padding: 0 100rpx 0 50rpx;
  font-size: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(217, 79, 48, 0.2);
}

.search-icon {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #ff7a59;
  font-size: 40rpx;
}

.medicine-list {
  height: calc(100vh - 240rpx);
}

.category-section {
  margin-bottom: 40rpx;
  background-color: white;
  border-radius: 36rpx;
  padding: 30rpx;
  box-shadow: 0 12rpx 36rpx rgba(217, 79, 48, 0.12);
}

.category-header {
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #ffe3d3;
}

.category-title {
  font-size: 40rpx;
  color: #d94f30;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.category-desc {
  font-size: 32rpx;
  color: #888;
}

.medicine-grid {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: 30rpx;
}

.medicine-card {
  background-color: #fff6f0;
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  transition: all 0.3s ease;
}

.medicine-card:active {
  transform: scale(0.98);
  background-color: #ffe3d3;
}

.medicine-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  background-color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(217, 79, 48, 0.2);
  flex-shrink: 0;
}

.medicine-icon {
  width: 100rpx;
  height: 100rpx;
}

.medicine-info {
  flex: 1;
}

.medicine-name {
  font-size: 36rpx;
  color: #d94f30;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.medicine-desc {
  font-size: 32rpx;
  color: #888;
  display: block;
}

/* 详情弹窗样式 */
.medicine-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background: #fff;
  border-radius: 36rpx;
  padding: 40rpx;
  position: relative;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #ffe3d3;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 30rpx;
  color: #d94f30;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  padding: 10rpx;
  color: #d94f30;
}

.modal-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #d94f30;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  padding: 10rpx;
  color: #d94f30;
}

.modal-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 40rpx;
  color: #d94f30;
  margin-bottom: 24rpx;
  font-weight: bold;
}

.section-content {
  font-size: 36rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
} 