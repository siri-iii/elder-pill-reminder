/* pages/userMode/userMode.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(180deg, #fff6f0 0%, #ffe3d3 100%);
  box-sizing: border-box;
}

.main-content {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-top: 60rpx;
  margin-bottom: 10rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 120, 80, 0.12);
}

.slogan {
  font-size: 28rpx;
  color: #d94f30;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #d94f30;
  margin-top: 10rpx;
  text-align: center;
}

.subtitle {
  font-size: 32rpx;
  color: #666;
  margin-top: 20rpx;
  margin-bottom: 60rpx;
}

.mode-container {
  width: 100%;
  display: flex;
  justify-content: space-around;
  padding: 0 40rpx;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.mode-card {
  width: 340rpx;
  height: 460rpx;
  background: #fff;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(217, 79, 48, 0.12);
  border: 4rpx solid transparent;
  margin: 0 20rpx;
  transition: box-shadow 0.2s, border 0.2s, transform 0.1s;
}

.mode-card:active {
  border: 4rpx solid #d94f30;
  box-shadow: 0 16rpx 48rpx rgba(217, 79, 48, 0.18);
  transform: scale(0.97);
}

.mode-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 20rpx;
}

.mode-label {
  font-size: 36rpx;
  color: #d94f30;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-top: 10rpx;
}

.mode-desc {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
  text-align: center;
}

.footer-links {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: #aaa;
  padding-bottom: env(safe-area-inset-bottom);
}

.footer-link {
  color: #aaa;
  margin: 0 24rpx;
  text-decoration: underline;
}

.footer-link:active {
  color: #d94f30;
}

.footer-divider {
  color: #ccc;
  margin: 0 8rpx;
}

/* 高对比度模式预留样式 */
.high-contrast .container {
  background: #000 !important;
}
.high-contrast .title,
.high-contrast .slogan,
.high-contrast .mode-label {
  color: #fff !important;
}
.high-contrast .mode-card {
  background: #222 !important;
  border: 4rpx solid #fff !important;
}
.high-contrast .mode-desc {
  color: #fff !important;
}
.high-contrast .footer-link {
  color: #fff !important;
}
