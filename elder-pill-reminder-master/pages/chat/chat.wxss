.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #fff6f0 0%, #ffe3d3 100%);
}

.header {
  background: linear-gradient(to right, #ffb199, #ff7a59);
  padding: 30rpx;
  color: white;
  box-shadow: 0 2rpx 10rpx rgba(217, 79, 48, 0.2);
}

.title-section {
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 32rpx;
  opacity: 0.9;
}

.chat-messages {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
  width: 100%;
}

.user-message {
  flex-direction: row-reverse;
  justify-content: flex-start;
}

.ai-message {
  flex-direction: row;
  justify-content: flex-start;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin: 0 20rpx;
  border: 2rpx solid #ff7a59;
  background-color: white;
  box-shadow: 0 2rpx 10rpx rgba(217, 79, 48, 0.1);
  flex-shrink: 0;
}

.message-content {
  max-width: 70%;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
  line-height: 1.6;
  position: relative;
  word-wrap: break-word;
}

.user-message .message-content {
  background-color: #ff7a59;
  color: white;
  border-top-right-radius: 4rpx;
  margin-right: 20rpx;
}

.ai-message .message-content {
  background-color: #fff6f0;
  color: #d94f30;
  border-top-left-radius: 4rpx;
  margin-left: 20rpx;
}

.suggested-questions {
  padding: 20rpx;
  background-color: white;
  border-top: 2rpx solid #ffe3d3;
}

.suggested-title {
  font-size: 36rpx;
  color: #d94f30;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.question-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.question-item {
  background: #fff6f0;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #d94f30;
  text-align: center;
  border: 2rpx solid #ffe3d3;
}

.question-item:active {
  background: #ffe3d3;
  transform: scale(0.98);
}

.input-area {
  padding: 20rpx;
  background-color: white;
  border-top: 2rpx solid #ffe3d3;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  background-color: #fff6f0;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}

.input-placeholder {
  color: #ffb199;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  background-color: #ffb199;
  color: white;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  opacity: 0.6;
  transition: all 0.3s ease;
}

.send-btn.active {
  opacity: 1;
  background-color: #ff7a59;
}

.send-btn:active {
  transform: scale(0.95);
} 