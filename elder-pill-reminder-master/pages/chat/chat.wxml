<!-- 聊天页面 -->
<view class="chat-container">
  <!-- 标题区域 -->
  <view class="header">
    <view class="title-section">
      <text class="title">智能助手</text>
      <text class="subtitle">您的贴心健康顾问</text>
    </view>
  </view>

  <!-- 聊天内容区域 -->
  <scroll-view class="chat-messages" scroll-y="true" scroll-into-view="{{scrollToMessage}}">
    <view class="message {{item.type === 'user' ? 'user-message' : 'ai-message'}}" 
          wx:for="{{messages}}" 
          wx:key="index" 
          id="msg-{{index}}">
      <image class="avatar" 
             src="{{item.type === 'user' ? '/images/user-avatar.png' : '/images/ai-avatar.png'}}" 
             mode="aspectFit"></image>
      <view class="message-content">
        <text>{{item.content}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 推荐问题区域 -->
  <view class="suggested-questions">
    <view class="suggested-title">您可能想问：</view>
    <view class="question-grid">
      <view class="question-item" 
            wx:for="{{suggestedQuestions}}" 
            wx:key="index" 
            bindtap="onQuestionTap" 
            data-question="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input class="message-input" 
           value="{{inputMessage}}" 
           bindinput="onInputChange" 
           placeholder="请输入您的问题..."
           placeholder-class="input-placeholder"/>
    <view class="send-btn {{inputMessage ? 'active' : ''}}" bindtap="sendMessage">
      发送
    </view>
  </view>
</view> 